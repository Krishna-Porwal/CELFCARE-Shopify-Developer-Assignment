<section class="how-to-use section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="how-to-use__header">
      <p class="eyebrow">How to use</p>
      <h2>{{ section.settings.heading | default: 'AM/PM routine' }}</h2>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="how-to-use__steps">
        {% for block in section.blocks %}
          <article class="how-to-use__step" {{ block.shopify_attributes }}>
            <div class="how-to-use__step-number">0{{ forloop.index }}</div>
            <div class="how-to-use__content">
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p>{{ block.settings.text }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="how-to-use__empty">Add routine steps in the Theme Editor to display the AM/PM routine.</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "How to Use",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AM/PM routine"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to Use",
      "blocks": [
        { "type": "step", "settings": { "title": "AM: Cleanse & prep", "text": "Massage onto clean skin and let it settle before sunscreen." } },
        { "type": "step", "settings": { "title": "PM: Renewal layer", "text": "Apply to lightly damp skin to replenish moisture and support recovery overnight." } },
        { "type": "step", "settings": { "title": "Weekly: Boost", "text": "Use the refill and alternate with your usual routine for consistent results." } }
      ]
    }
  ]
}
{% endschema %}
