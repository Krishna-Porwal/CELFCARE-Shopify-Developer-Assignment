<section class="faq-accordion section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="faq-accordion__header">
      <p class="eyebrow">FAQ</p>
      <h2>{{ section.settings.heading | default: 'Frequently asked questions' }}</h2>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="faq-accordion__list">
        {% for block in section.blocks %}
          <div class="faq-accordion__item" {{ block.shopify_attributes }}>
            <details class="faq-accordion__details"{% if forloop.first %} open{% endif %}>
              <summary>
                <span>{{ block.settings.question }}</span>
              </summary>
              <div class="faq-accordion__answer rte">
                {{ block.settings.answer }}
              </div>
            </details>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="faq-accordion__empty">Add FAQ items in the Theme Editor.</div>
    {% endif %}
  </div>
</section>

<script src="{{ 'faq-accordion.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "faq", "settings": { "question": "Who is this for?", "answer": "<p>Ideal for dehydrated, dull, and early-aging skin.</p>" } },
        { "type": "faq", "settings": { "question": "Can I layer this with other serums?", "answer": "<p>Yes. Apply after cleansing and before moisturizer.</p>" } },
        { "type": "faq", "settings": { "question": "Is it suitable for sensitive skin?", "answer": "<p>Yes, it is formulated to support the skin barrier and is patch-tested.</p>" } },
        { "type": "faq", "settings": { "question": "Do I need both products?", "answer": "<p>The duo gives a complete ritual for firming and hydration.</p>" } },
        { "type": "faq", "settings": { "question": "How long before I see results?", "answer": "<p>Most customers notice smoother texture within 2–4 weeks.</p>" } }
      ]
    }
  ]
}
{% endschema %}
